{
  "name": "schema-gov-it-mcp",
  "version": "1.0.0",
  "description": "MCP Server for schema.gov.it SPARQL endpoint",
  "main": "dist/index.js",
  "bin": {
    "schema-gov-it-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "test:http": "node --test test/http-api.test.mjs",
    "test:mcp": "node --test test/mcp-protocol.test.mjs",
    "test": "npm run build && node --test test/http-api.test.mjs test/mcp-protocol.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/italia/dati-semantic-mcp.git"
  },
  "keywords": [
    "mcp",
    "sparql",
    "schema.gov.it",
    "ai",
    "semantic-web"
  ],
  "author": "Matteo Fortini",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "oxigraph": "^0.5.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "typescript": "^5.9.3"
  }
}
